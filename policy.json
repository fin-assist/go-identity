{
  "baseBranchPatterns": [
    "main"
  ],
  "packageRules": [
    {
      "description": "FIN-211: recovery of an automatically failed dependency family",
      "matchPackageNames": [
        "renovate"
      ],
      "matchDatasources": [
        "npm"
      ],
      "recreateWhen": "always",
      "matchJsonata": [
        "newMajor = 44"
      ]
    },
    {
      "description": "FIN-211: failed twice; retry explicitly in Dependency Dashboard",
      "matchPackageNames": [
        "renovate"
      ],
      "matchDatasources": [
        "npm"
      ],
      "dependencyDashboardApproval": true,
      "recreateWhen": "never",
      "groupName": null,
      "additionalBranchPrefix": "fin211-retry-33-",
      "matchJsonata": [
        "newDigest = \"sha512-pifD6RstfGlxvaQvqJDRkvc6nEXSYdvvs74DsD57dPZ019XoT7Psvf43XQiCPUsFfJXiSkFszAice7euOng5dQ==\""
      ]
    }
  ]
}
